load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sim_device",
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serial_port",
    srcs = ["serial_port.rs"],
    crate_root = "serial_port.rs",
    edition = "2024",
    deps = ["//device/os:terminal_options"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//device:__subpackages__", "//tool:__pkg__"],
)

rust_test(
    name = "serial_port_integration_test",
    srcs = ["serial_port_integration_test.rs"],
    crate_root = "serial_port_integration_test.rs",
    edition = "2024",
    deps = [":serial_port", "//device/os:terminal_options"],
    target_compatible_with = ["@platforms//os:linux"],
    size = "small",
)

rust_library(
    name = "sim7600_probe",
    srcs = ["sim7600_probe.rs"],
    crate_root = "sim7600_probe.rs",
    edition = "2024",
    deps = ["//device/at_protocol:at_command", "//device/at_protocol:at_exchange", "//device/at_protocol:at_response"],
    visibility = ["//tool:__pkg__"],
)

rust_test(
    name = "sim7600_probe_integration_test",
    srcs = ["sim7600_probe_integration_test.rs"],
    crate_root = "sim7600_probe_integration_test.rs",
    edition = "2024",
    deps = [":sim7600_probe"],
    size = "small",
)

rust_test(
    name = "sms_storage_probe_integration_test",
    srcs = ["sms_storage_probe_integration_test.rs"],
    crate_root = "sms_storage_probe_integration_test.rs",
    edition = "2024",
    deps = [":sim7600_probe"],
    size = "small",
)
