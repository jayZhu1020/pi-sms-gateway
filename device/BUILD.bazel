load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sim_device",
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "serial_port",
    srcs = ["serial_port.rs"],
    crate_root = "serial_port.rs",
    edition = "2024",
    deps = ["//device/os:terminal_options"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//device:__subpackages__"],
)

rust_test(
    name = "serial_port_test",
    crate = ":serial_port",
    size = "small",
)
