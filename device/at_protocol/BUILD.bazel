load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "at_decoder",
    srcs = ["at_decoder.rs"],
    deps = [":at_constant"],
    crate_root = "at_decoder.rs",
    edition = "2024",
    visibility = ["//device:__pkg__"],
)

rust_test(
    name = "at_decoder_test",
    crate = ":at_decoder",
    size = "small",
)

