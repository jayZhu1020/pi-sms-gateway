load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "at_decoder",
    srcs = ["at_decoder.rs", "at_constant.rs"],
    crate_root = "at_decoder.rs",
    edition = "2024",
    visibility = ["//device:__pkg__"],
)

rust_test(
    name = "at_decoder_test",
    crate = ":at_decoder",
    size = "small",
)

rust_library(
    name = "at_response",
    srcs = ["at_response.rs"],
    crate_root = "at_response.rs",
    edition = "2024",
    visibility = ["//device:__pkg__"],
)

rust_test(
    name = "at_response_test",
    crate = ":at_response",
    size = "small",
)

rust_library(
    name = "serial_port",
    srcs = ["serial_port.rs"],
    crate_root = "serial_port.rs",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//device:__pkg__"],
)

rust_test(
    name = "serial_port_test",
    crate = ":serial_port",
    size = "small",
)
